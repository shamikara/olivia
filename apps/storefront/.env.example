# Copy to .env.local and fill in. Everything here is optional in development —
# the storefront runs without any of it, with the gateways switched off.

# Public origin the payment gateways redirect back to, and the origin Koko posts
# its server callback to. Must be publicly reachable in production; use a tunnel
# (ngrok, cloudflared) when testing against a sandbox, since Koko cannot reach
# localhost.
NEXT_PUBLIC_SITE_URL=https://oliviaglow.lk

# --- Koko (paykoko.com) -----------------------------------------------------
# Issued by Koko after merchant onboarding. Set these in production rather than
# pasting them into the admin panel: values here override anything stored in
# data/settings.json, and the admin form shows them as locked.
# PEM newlines may be written literally as \n.
KOKO_MERCHANT_ID=
KOKO_API_KEY=
KOKO_PUBLIC_KEY=
KOKO_PRIVATE_KEY=
# Optional: overrides the sandbox/live host if Koko gives you a different one.
# KOKO_API_BASE=https://qaapi.paykoko.com

# --- Mintpay (mintpay.lk) ---------------------------------------------------
MINTPAY_MERCHANT_ID=
MINTPAY_MERCHANT_SECRET=
# MINTPAY_API_BASE=https://dev.mintpay.lk

# --- PayPal -------------------------------------------------------------
# From a PayPal REST app (developer.paypal.com/dashboard/applications). Client
# ID is public and gets sent to the browser to load PayPal's embedded buttons;
# client secret is server-only. PayPal does not settle in LKR, so orders are
# charged in USD, converted from the LKR total at a live rate fetched at
# checkout time.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Sessions ---------------------------------------------------------------
# REQUIRED. Signing secrets for the admin and customer session cookies. Both
# fall back to a hardcoded, publicly known default, which means a session
# cookie can be forged. Generate with: openssl rand -base64 32
JWT_SECRET=
CUSTOMER_JWT_SECRET=

# Admin credentials are NOT configured here. Accounts live in the admin_users
# table (migration 0004) with scrypt-hashed passwords; the first one is seeded
# by that migration. There is no env fallback and no default password, so an
# empty table means nobody can sign in.

# --- Database (Supabase Postgres) -------------------------------------------
# REQUIRED. Orders, customers, products, discounts and settings live here.
# There is no file-based fallback: a serverless host has no writable disk, so
# every write to one was being silently lost. Apply the migrations in
# supabase/migrations/ to the project these point at.
#
# The same pair also configures media storage below — one Supabase project
# serves both.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---------------------------------------------------------
# Order confirmations, invoices, status updates and account mail. Without
# these, sends are skipped with a warning in the log rather than failing the
# request that triggered them — an order is never lost because a receipt was.
#
# EMAIL_FROM must be on a domain verified in Resend (its DKIM/SPF records
# published in DNS), or messages are accepted and then filtered by recipients.
RESEND_API_KEY=
EMAIL_FROM="Olivia Glow <orders@oliviaglow.lk>"
# Where customer replies go, if different from EMAIL_FROM.
EMAIL_REPLY_TO=
# Blind-copies order and invoice mail to the shop, for a record outside the DB.
EMAIL_BCC=

# --- Media storage (Supabase Storage) ---------------------------------------
# Product images are optimized on upload and served from a public Supabase
# bucket. Configured by SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above —
# one project serves both the database and media.
#
# Without those, uploads fall back to writing into public/images/products/,
# which works locally and fails on a read-only serverless filesystem.
SUPABASE_MEDIA_BUCKET=product-media

# A replaced image is not deleted straight away: its files are queued and
# purged only after this grace period, so a bad upload can be rolled back and
# a stale page reference doesn't 404 in the meantime.
MEDIA_CLEANUP_GRACE_HOURS=168
# How often the scheduled purge is allowed to actually run. The scheduler
# itself (see vercel.json) can fire more often — extra runs within the
# interval are no-ops.
MEDIA_CLEANUP_INTERVAL_HOURS=24
# Authenticates the scheduled cleanup endpoint. Vercel Cron automatically
# sends `Authorization: Bearer $CRON_SECRET` when this is set; any other
# scheduler must add that header itself with the same value.
CRON_SECRET=
