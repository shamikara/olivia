# Copy to .env.local and fill in. Everything here is optional in development —
# the storefront runs without any of it, with the gateways switched off.

# Public origin the payment gateways redirect back to, and the origin Koko posts
# its server callback to. Must be publicly reachable in production; use a tunnel
# (ngrok, cloudflared) when testing against a sandbox, since Koko cannot reach
# localhost.
NEXT_PUBLIC_SITE_URL=https://oliviaglow.lk

# --- Koko (paykoko.com) -----------------------------------------------------
# Issued by Koko after merchant onboarding. Set these in production rather than
# pasting them into the admin panel: values here override anything stored in
# data/settings.json, and the admin form shows them as locked.
# PEM newlines may be written literally as \n.
KOKO_MERCHANT_ID=
KOKO_API_KEY=
KOKO_PUBLIC_KEY=
KOKO_PRIVATE_KEY=
# Optional: overrides the sandbox/live host if Koko gives you a different one.
# KOKO_API_BASE=https://qaapi.paykoko.com

# --- Mintpay (mintpay.lk) ---------------------------------------------------
MINTPAY_MERCHANT_ID=
MINTPAY_MERCHANT_SECRET=
# MINTPAY_API_BASE=https://dev.mintpay.lk

# --- Admin ------------------------------------------------------------------
# Both currently fall back to insecure defaults. Set them before launch.
ADMIN_PASSWORD=
JWT_SECRET=
CUSTOMER_JWT_SECRET=

# --- Media pipeline (Google Drive originals -> optimized Supabase Storage) --
# Optional in development: without these, product image uploads fall back to
# writing straight to public/images/products/ as before.
#
# Service account with the Drive API enabled, sharing "view/edit" access to
# GOOGLE_DRIVE_ROOT_FOLDER_ID only (not the whole Drive).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM newlines may be written literally as \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The Drive folder id that will hold one subfolder per product id.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Supabase project used for optimized media storage and sync metadata.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=product-media

# How often a scheduled sync is allowed to actually run (24 or 48 are typical).
# The scheduler itself (see vercel.json) can fire more often than this —
# extra runs within the interval are no-ops.
MEDIA_SYNC_INTERVAL_HOURS=24
# How long a superseded/deleted optimized file waits before being purged.
MEDIA_CLEANUP_GRACE_HOURS=168
# Authenticates the scheduled sync endpoint. Vercel Cron automatically sends
# `Authorization: Bearer $CRON_SECRET` when this is set; any other scheduler
# must add that header itself with the same value.
CRON_SECRET=
